#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

CONF="vnt2"

CLI_LOG="/tmp/vnt2-cli.log"
WEB_LOG="/tmp/vnt2-web.log"
SERVER_LOG="/tmp/vnts2.log"
DOWNLOAD_LOG="/tmp/vnt2-download.log"

CLI_TIME="/tmp/vnt2_cli_time"
WEB_TIME="/tmp/vnt2_web_time"
SERVER_TIME="/tmp/vnts2_time"

CLI_WEB_CONF_DEFAULT="/vnt_config/vnt2_cli_web.toml"
CLI_CONF_DEFAULT="${CLI_WEB_CONF_DEFAULT}"
WEB_CONF_DEFAULT="${CLI_WEB_CONF_DEFAULT}"
SERVER_CONF_DEFAULT="/etc/config/vnts2.toml"

LEGACY_DEFAULT_SERVER="tcp://8.163.89.234:29872"
DEPRECATED_DEFAULT_SERVER="tcp://0.0.0.0:29872"

CLI_CONF_FILE=""
WEB_CONF_FILE=""
SERVER_CONF_FILE=""

DOWNLOAD_CACHE_BASE="/tmp/vnt2-download-cache"
DOWNLOAD_CLI_STATE="/tmp/vnt2-download-cli.state"
DOWNLOAD_WEB_STATE="/tmp/vnt2-download-web.state"
DOWNLOAD_SERVER_STATE="/tmp/vnt2-download-server.state"

INSTALL_BIN_DIR="/usr/bin"

. /lib/functions.sh
. /lib/functions/procd.sh

log_cli() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') vnt2-cli : $*" >>"${CLI_LOG}"
}

log_web() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') vnt2-web : $*" >>"${WEB_LOG}"
}

log_server() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') vnts2 : $*" >>"${SERVER_LOG}"
}

log_download() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') download : $*" >>"${DOWNLOAD_LOG}"
}

ensure_log_files() {
	[ -f "${CLI_LOG}" ] || : >"${CLI_LOG}"
	[ -f "${WEB_LOG}" ] || : >"${WEB_LOG}"
	[ -f "${SERVER_LOG}" ] || : >"${SERVER_LOG}"
	[ -f "${DOWNLOAD_LOG}" ] || : >"${DOWNLOAD_LOG}"
}

get_first_section_id() {
	local type="$1"
	local section=""
	config_foreach __collect_first_section "$type"
	section="$FIRST_SECTION_ID"
	FIRST_SECTION_ID=""
	echo "$section"
}

__collect_first_section() {
	local section="$1"
	[ -n "$FIRST_SECTION_ID" ] || FIRST_SECTION_ID="$section"
}

trim_value() {
	echo "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

find_firewall_zone_name() {
	local wanted_network="$1"
	local idx=0
	local fallback=""
	local zone_name network_list net

	while uci -q show "firewall.@zone[$idx]" >/dev/null 2>&1; do
		zone_name="$(trim_value "$(uci -q get "firewall.@zone[$idx].name" 2>/dev/null)")"
		network_list="$(trim_value "$(uci -q get "firewall.@zone[$idx].network" 2>/dev/null)")"

		if [ -n "$zone_name" ]; then
			[ "$zone_name" = "$wanted_network" ] && fallback="$zone_name"
			for net in $network_list; do
				[ "$net" = "$wanted_network" ] && {
					echo "$zone_name"
					return 0
				}
			done
		fi

		idx=$((idx + 1))
	done

	[ -n "$fallback" ] && {
		echo "$fallback"
		return 0
	}

	return 1
}

host_allows_external_access() {
	local host
	host="$(trim_value "$1")"

	case "$host" in
		""|"127.0.0.1"|"::1"|"localhost")
			return 1
		;;
	esac

	return 0
}

extract_bind_host() {
	local bind host
	bind="$(trim_value "$1")"
	host="${bind%:*}"
	host="${host#\[}"
	host="${host%\]}"
	echo "$host"
}

bind_allows_external_access() {
	local bind_host
	bind_host="$(extract_bind_host "$1")"
	host_allows_external_access "$bind_host"
}

ensure_conf_path_ready() {
	local conf_path="$1"
	local conf_dir

	conf_path="$(trim_value "$conf_path")"
	[ -n "$conf_path" ] || return 1

	conf_dir="${conf_path%/*}"
	if [ -n "$conf_dir" ] && [ "$conf_dir" != "$conf_path" ]; then
		mkdir -p "$conf_dir" >/dev/null 2>&1
		chmod 777 "$conf_dir" >/dev/null 2>&1
	fi

	if [ -e "$conf_path" ]; then
		chmod 777 "$conf_path" >/dev/null 2>&1
	fi

	return 0
}

resolve_client_conf_file() {
	local cfg="$1"
	local conf_path

	[ -n "$cfg" ] || cfg="$(get_first_section_id "vnt2_cli")"
	config_get conf_path "$cfg" "client_conf_file" "$CLI_CONF_DEFAULT"
	conf_path="$(trim_value "$conf_path")"
	[ -n "$conf_path" ] || conf_path="$CLI_CONF_DEFAULT"
	echo "$conf_path"
}

resolve_web_conf_file() {
	local cfg="$1"
	local conf_path

	[ -n "$cfg" ] || cfg="$(get_first_section_id "vnt2_web")"
	config_get conf_path "$cfg" "web_conf_file" "$WEB_CONF_DEFAULT"
	conf_path="$(trim_value "$conf_path")"
	[ -n "$conf_path" ] || conf_path="$WEB_CONF_DEFAULT"
	echo "$conf_path"
}

resolve_server_conf_file() {
	local cfg="$1"
	local conf_path

	[ -n "$cfg" ] || cfg="$(get_first_section_id "vnts2")"
	config_get conf_path "$cfg" "server_conf_file" "$SERVER_CONF_DEFAULT"
	conf_path="$(trim_value "$conf_path")"
	[ -n "$conf_path" ] || conf_path="$SERVER_CONF_DEFAULT"
	echo "$conf_path"
}

migrate_legacy_client_server() {
	local cfg="$1"
	local server_list=""
	local first_server=""
	local changed="0"

	[ -n "$cfg" ] || return 0

	config_list_foreach "$cfg" server append_server_item
	server_list="${VNT2_SERVER_LIST}"
	VNT2_SERVER_LIST=""

	first_server="${server_list%% *}"
	first_server="$(trim_value "$first_server")"

	if [ "$server_list" = "$LEGACY_DEFAULT_SERVER" ] || [ "$server_list" = "$DEPRECATED_DEFAULT_SERVER" ]; then
		uci -q delete ${CONF}.${cfg}.server
		uci commit ${CONF} >/dev/null 2>&1
		changed="1"
		log_cli 'legacy default server detected, cleared client server list'
	fi

	return 0
}

sanitize_name() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g'
}

write_download_state() {
	local state_file="$1"
	local state="$2"
	local message="$3"
	local asset="$4"
	local tag="$5"
	local arch="$6"
	local path="$7"

	cat >"${state_file}" <<EOF
state=${state}
message=${message}
asset=${asset}
tag=${tag}
arch=${arch}
path=${path}
time=$(date '+%Y-%m-%d %H:%M:%S')
EOF
}

ensure_exec() {
	local bin="$1"
	[ -n "$bin" ] || return 1
	[ -f "$bin" ] || return 1
	chmod 755 "$bin" >/dev/null 2>&1
	return 0
}

export_toml_from_uci() {
	lua - <<'EOF' >/dev/null 2>&1
package.path = package.path .. ";/usr/lib/lua/?.lua;/usr/lib/lua/?/init.lua"
package.cpath = package.cpath .. ";/usr/lib/lua/?.so;/usr/lib/lua/loadall.so"
local ok_uci, uci_mod = pcall(require, "luci.model.uci")
local ok_toml, toml = pcall(require, "luci.model.vnt2_toml")
if not ok_uci or not ok_toml then
	os.exit(1)
end
local uci = uci_mod.cursor()
toml.export_uci_to_toml(uci)
uci:commit("vnt2")
EOF
}

find_uploaded_bin() {
	local name="$1"
	for file in "/tmp/${name}" "/tmp/${name//_/-}" "/tmp/${name}.bin"; do
		[ -f "$file" ] && {
			echo "$file"
			return 0
		}
	done
	return 1
}

detect_arch_name() {
	local mach arch
	mach="$(uname -m 2>/dev/null)"
	arch="$(opkg print-architecture 2>/dev/null | awk 'NR==1 {print $2}')"

	case "$mach" in
		x86_64|amd64)
			echo "x86_64"
			return 0
		;;
		aarch64|arm64)
			echo "aarch64"
			return 0
		;;
		armv7*|armv6*|arm*)
			echo "arm"
			return 0
		;;
		mips64el*)
			echo "mips64el"
			return 0
		;;
		mipsel*)
			echo "mipsel"
			return 0
		;;
		mips*)
			echo "mips"
			return 0
		;;
		i386|i486|i586|i686)
			echo "x86"
			return 0
		;;
	esac

	case "$arch" in
		*x86_64*|*amd64*)
			echo "x86_64"
		;;
		*aarch64*|*arm64*)
			echo "aarch64"
		;;
		*arm*)
			echo "arm"
		;;
		*mips64el*)
			echo "mips64el"
		;;
		*mipsel*)
			echo "mipsel"
		;;
		*mips*)
			echo "mips"
		;;
		*x86*|*i386*|*i686*)
			echo "x86"
		;;
		*)
			echo "${mach:-unknown}"
		;;
	esac
}

detect_arch_patterns() {
	case "$1" in
		x86_64)
			echo "x86_64 amd64 x86-64"
		;;
		aarch64)
			echo "aarch64 arm64 armv8"
		;;
		arm)
			echo "armv7 armhf armv6 arm"
		;;
		mips64el)
			echo "mips64el mips64"
		;;
		mipsel)
			echo "mipsel mipsel_24kc mipsel24kc"
		;;
		mips)
			echo "mips mips_24kc mips24kc"
		;;
		x86)
			echo "x86 i386 i686"
		;;
		*)
			echo "$1"
		;;
	esac
}

get_downloader() {
	local purpose="$1"

	case "$purpose" in
		asset)
			if command -v curl >/dev/null 2>&1; then
				echo "curl"
				return 0
			fi
			if command -v wget >/dev/null 2>&1; then
				echo "wget"
				return 0
			fi
			if command -v uclient-fetch >/dev/null 2>&1; then
				echo "uclient-fetch"
				return 0
			fi
		;;
		*)
			if command -v curl >/dev/null 2>&1; then
				echo "curl"
				return 0
			fi
			if command -v uclient-fetch >/dev/null 2>&1; then
				echo "uclient-fetch"
				return 0
			fi
			if command -v wget >/dev/null 2>&1; then
				echo "wget"
				return 0
			fi
		;;
	esac

	return 1
}

download_file() {
	local url="$1"
	local out="$2"
	local purpose="${3:-generic}"
	local downloader
	local rc

	downloader="$(get_downloader "$purpose")" || return 1
	DOWNLOAD_LAST_TOOL="$downloader"

	case "$downloader" in
		curl)
			curl -fsSL --connect-timeout 20 --max-time 600 --retry 3 --retry-delay 2 \
				-A "luci-app-vnt2" \
				-H "Accept: application/vnd.github+json, application/octet-stream, */*" \
				-o "$out" "$url" >/dev/null 2>&1
			rc=$?
		;;
		wget)
			wget -q --timeout=30 --tries=3 \
				--header="User-Agent: luci-app-vnt2" \
				--header="Accept: application/vnd.github+json, application/octet-stream, */*" \
				-O "$out" "$url" >/dev/null 2>&1
			rc=$?
		;;
		uclient-fetch)
			uclient-fetch -q -T 30 \
				--header "User-Agent: luci-app-vnt2" \
				--header "Accept: application/vnd.github+json, application/octet-stream, */*" \
				-O "$out" "$url" >/dev/null 2>&1
			rc=$?
		;;
		*)
			return 1
		;;
	esac

	return $rc
}

normalize_release_tag() {
	local tag="$1"
	tag="$(trim_value "$tag")"
	tag="${tag#v}"
	tag="${tag#V}"
	echo "$tag"
}

resolve_v2_release_tag() {
	local repo="$1"
	local tag="$2"

	[ -n "$repo" ] || repo="vnt-dev/vnt"
	tag="$(trim_value "$tag")"

	case "$repo" in
		vnt-dev/vnt|vnt-dev/vnts)
			if [ -z "$tag" ] || [ "$tag" = "latest" ]; then
				echo "2.0.0"
			else
				normalize_release_tag "$tag"
			fi
		;;
		*)
			if [ -n "$tag" ] && [ "$tag" != "latest" ]; then
				normalize_release_tag "$tag"
			else
				echo "$tag"
			fi
		;;
	esac
}

normalize_download_mirror() {
	local mirror="$1"

	mirror="$(trim_value "$mirror" | tr 'A-Z' 'a-z')"
	case "$mirror" in
		github|gitee|gitlab|cloudflare)
			echo "$mirror"
		;;
		*)
			echo "github"
		;;
	esac
}

repo_to_mirror_project() {
	local repo="$1"

	repo="$(trim_value "$repo")"
	case "$repo" in
		vnt-dev/vnt)
			echo "vnt"
			return 0
		;;
		vnt-dev/vnts)
			echo "vnts"
			return 0
		;;
	esac

	return 1
}

select_download_mirror() {
	local repo="$1"
	local mirror="$2"

	mirror="$(normalize_download_mirror "$mirror")"
	[ "$mirror" = "github" ] && {
		echo "github"
		return 0
	}

	if repo_to_mirror_project "$repo" >/dev/null 2>&1; then
		echo "$mirror"
	else
		echo "github"
	fi
}

get_release_list_url() {
	local repo="$1"
	local mirror="$2"
	local effective_mirror proj

	[ -n "$repo" ] || repo="vnt-dev/vnt"
	effective_mirror="$(select_download_mirror "$repo" "$mirror")"

	if [ "$effective_mirror" = "github" ]; then
		echo "https://api.github.com/repos/${repo}/releases"
		return 0
	fi

	proj="$(repo_to_mirror_project "$repo")" || return 1
	case "$effective_mirror" in
		gitee)
			echo "https://gitee.com/api/v5/repos/whzhni/${proj}/releases"
		;;
		gitlab)
			echo "https://gitlab.com/api/v4/projects/whzhni%2F${proj}/releases"
		;;
		cloudflare)
			echo "https://pub-8a57d35d70d5423aac22a3316867e7ce.r2.dev/${proj}/releases"
		;;
		*)
			echo "https://api.github.com/repos/${repo}/releases"
		;;
	esac
}

get_release_api_url() {
	local repo="$1"
	local tag="$2"
	local mirror="$3"
	local resolved_tag effective_mirror

	[ -n "$repo" ] || repo="vnt-dev/vnt"
	effective_mirror="$(select_download_mirror "$repo" "$mirror")"

	if [ "$effective_mirror" != "github" ]; then
		get_release_list_url "$repo" "$effective_mirror"
		return 0
	fi

	resolved_tag="$(resolve_v2_release_tag "$repo" "$tag")"

	if [ -z "$resolved_tag" ] || [ "$resolved_tag" = "latest" ]; then
		echo "https://api.github.com/repos/${repo}/releases/latest"
	else
		echo "https://api.github.com/repos/${repo}/releases/tags/${resolved_tag}"
	fi
}

get_release_api_candidates() {
	local repo="$1"
	local tag="$2"
	local mirror="$3"
	local resolved_tag normalized_tag effective_mirror

	[ -n "$repo" ] || repo="vnt-dev/vnt"
	effective_mirror="$(select_download_mirror "$repo" "$mirror")"

	if [ "$effective_mirror" != "github" ]; then
		get_release_list_url "$repo" "$effective_mirror"
		return 0
	fi

	resolved_tag="$(resolve_v2_release_tag "$repo" "$tag")"
	normalized_tag="$(normalize_release_tag "$resolved_tag")"

	if [ -z "$resolved_tag" ] || [ "$resolved_tag" = "latest" ]; then
		echo "https://api.github.com/repos/${repo}/releases/latest"
		return 0
	fi

	echo "https://api.github.com/repos/${repo}/releases/tags/${resolved_tag}"

	if [ -n "$normalized_tag" ] && [ "$resolved_tag" = "$normalized_tag" ]; then
		echo "https://api.github.com/repos/${repo}/releases/tags/v${normalized_tag}"
	fi

	echo "https://api.github.com/repos/${repo}/releases/latest"
}

extract_release_urls() {
	local json_file="$1"

	grep -o 'https://[^"]*' "$json_file" 2>/dev/null | \
		sed 's#\\/#/#g' | awk 'NF && !seen[$0]++'
}

extract_first_release_object() {
	local src="$1"
	local dst="$2"

	awk '
BEGIN {
	in_array = 0
	depth = 0
	started = 0
	out = ""
}
{
	line = $0
	if (!in_array) {
		pos = index(line, "[")
		if (pos > 0) {
			in_array = 1
			line = substr(line, pos + 1)
		} else {
			next
		}
	}
	for (i = 1; i <= length(line); i++) {
		c = substr(line, i, 1)
		if (!started) {
			if (c == "{") {
				started = 1
				depth = 1
				out = "{"
			}
			continue
		}
		out = out c
		if (c == "{") depth++
		if (c == "}") {
			depth--
			if (depth == 0) {
				print out
				exit
			}
		}
	}
}
' "$src" >"$dst"

	[ -s "$dst" ]
}

extract_release_object_by_tag() {
	local src="$1"
	local dst="$2"
	local wanted_tag="$3"

	awk -v wanted="$wanted_tag" '
BEGIN {
	in_array = 0
	depth = 0
	started = 0
	out = ""
}
{
	line = $0
	if (!in_array) {
		pos = index(line, "[")
		if (pos > 0) {
			in_array = 1
			line = substr(line, pos + 1)
		} else {
			next
		}
	}
	for (i = 1; i <= length(line); i++) {
		c = substr(line, i, 1)
		if (!started) {
			if (c == "{") {
				started = 1
				depth = 1
				out = "{"
			}
			continue
		}
		out = out c
		if (c == "{") depth++
		if (c == "}") {
			depth--
			if (depth == 0) {
				if (out ~ "\"tag_name\"[[:space:]]*:[[:space:]]*\"" wanted "\"") {
					print out
					exit
				}
				started = 0
				out = ""
			}
		}
	}
}
' "$src" >"$dst"

	[ -s "$dst" ]
}

fetch_release_metadata() {
	local repo="$1"
	local tag="$2"
	local json_file="$3"
	local mirror="$4"
	local api_url response_tag candidate list_file resolved_tag normalized_tag effective_mirror

	effective_mirror="$(select_download_mirror "$repo" "$mirror")"

	if [ "$effective_mirror" != "github" ]; then
		list_file="${json_file}.list"
		api_url="$(get_release_list_url "$repo" "$effective_mirror")"
		log_download "checking ${effective_mirror} releases list: ${api_url}"
		if download_file "$api_url" "$list_file" "api"; then
			resolved_tag="$(resolve_v2_release_tag "$repo" "$tag")"
			normalized_tag="$(normalize_release_tag "$resolved_tag")"

			if [ -z "$resolved_tag" ] || [ "$resolved_tag" = "latest" ]; then
				if extract_first_release_object "$list_file" "$json_file"; then
					echo "${api_url}#latest-from-list"
					return 0
				fi
			else
				if extract_release_object_by_tag "$list_file" "$json_file" "$resolved_tag"; then
					echo "${api_url}#tag-from-list:${resolved_tag}"
					return 0
				fi
				if [ -n "$normalized_tag" ] && extract_release_object_by_tag "$list_file" "$json_file" "v${normalized_tag}"; then
					echo "${api_url}#tag-from-list:v${normalized_tag}"
					return 0
				fi
				if extract_first_release_object "$list_file" "$json_file"; then
					echo "${api_url}#fallback-first"
					return 0
				fi
			fi
		fi

		return 1
	fi

	for candidate in $(get_release_api_candidates "$repo" "$tag" "$effective_mirror"); do
		log_download "checking release endpoint: ${candidate}"
		if download_file "$candidate" "$json_file" "api"; then
			response_tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$json_file" | head -n1)"
			if [ -n "$response_tag" ]; then
				echo "$candidate"
				return 0
			fi
		fi
	done

	list_file="${json_file}.list"
	api_url="$(get_release_list_url "$repo" "$effective_mirror")"
	log_download "checking releases list: ${api_url}"
	if download_file "$api_url" "$list_file" "api"; then
		resolved_tag="$(resolve_v2_release_tag "$repo" "$tag")"
		normalized_tag="$(normalize_release_tag "$resolved_tag")"

		if [ -z "$resolved_tag" ] || [ "$resolved_tag" = "latest" ]; then
			if extract_first_release_object "$list_file" "$json_file"; then
				echo "${api_url}#latest-from-list"
				return 0
			fi
		else
			if extract_release_object_by_tag "$list_file" "$json_file" "$resolved_tag"; then
				echo "${api_url}#tag-from-list:${resolved_tag}"
				return 0
			fi
			if [ -n "$normalized_tag" ] && extract_release_object_by_tag "$list_file" "$json_file" "v${normalized_tag}"; then
				echo "${api_url}#tag-from-list:v${normalized_tag}"
				return 0
			fi
			if extract_first_release_object "$list_file" "$json_file"; then
				echo "${api_url}#fallback-first"
				return 0
			fi
		fi
	fi

	return 1
}

select_release_asset() {
	local json_file="$1"
	local arch_patterns="$2"
	local scope="$3"
	local urls asset pattern primary_arch

	urls="$(extract_release_urls "$json_file")"
	[ -n "$urls" ] || return 1
	primary_arch="$(printf '%s\n' "$arch_patterns" | awk '{print $1}')"

	case "$scope" in
		cli|web)
			if [ -n "$primary_arch" ]; then
				asset="$(printf '%s\n' "$urls" | grep -iE "/vnt2[-_]${primary_arch}[-_].*unknown-linux-musl.*\.zip$" | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			fi

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -iE '/vnt2[-_]' | grep -i "$pattern" | grep -i 'unknown-linux-musl' | grep -iE '\.zip$' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -iE '/vnt2[-_]' | grep -i "$pattern" | grep -i 'unknown-linux-musl' | grep -iE '(\.tar\.gz|\.tgz|\.tar\.xz|\.zip)$' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -iE '/vnt(2)?[-_]' | grep -i "$pattern" | grep -iE '(linux|musl|openwrt)' | grep -iE '(\.tar\.gz|\.tgz|\.tar\.xz|\.zip)$' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -i "$pattern" | grep -iE '(vnt2|vnt|cli|ctrl|web)' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			asset="$(printf '%s\n' "$urls" | grep -iE '/vnt2[-_]' | head -n1)"
			[ -n "$asset" ] && {
				echo "$asset"
				return 0
			}

			asset="$(printf '%s\n' "$urls" | grep -iE '/vnt(2)?[-_]' | head -n1)"
			[ -n "$asset" ] && {
				echo "$asset"
				return 0
			}
		;;
		server)
			if [ -n "$primary_arch" ]; then
				asset="$(printf '%s\n' "$urls" | grep -iE "/vnts2[-_]${primary_arch}[-_].*unknown-linux-musl[^./]*$" | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			fi

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -iE '/vnts2[-_]' | grep -i "$pattern" | grep -i 'unknown-linux-musl' | grep -ivE '(\.tar\.gz|\.tgz|\.tar\.xz|\.zip)$' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -iE '/vnts2[-_]' | grep -i "$pattern" | grep -iE '(linux|musl|openwrt)' | grep -iE '(\.tar\.gz|\.tgz|\.tar\.xz|\.zip)$' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -iE '/vnts(2)?[-_]' | grep -i "$pattern" | grep -iE '(linux|musl|openwrt)' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			for pattern in $arch_patterns; do
				asset="$(printf '%s\n' "$urls" | grep -i "$pattern" | grep -iE '(vnts2|vnts|server)' | head -n1)"
				[ -n "$asset" ] && {
					echo "$asset"
					return 0
				}
			done

			asset="$(printf '%s\n' "$urls" | grep -iE '/vnts2[-_]' | head -n1)"
			[ -n "$asset" ] && {
				echo "$asset"
				return 0
			}

			asset="$(printf '%s\n' "$urls" | grep -iE '/vnts(2)?[-_]' | head -n1)"
			[ -n "$asset" ] && {
				echo "$asset"
				return 0
			}
		;;
	esac

	asset="$(printf '%s\n' "$urls" | grep -iE '/[^/]*(vnt2|vnt|vnts2|vnts)[^/]*(\.tar\.gz|\.tgz|\.tar\.xz|\.zip)?$' | head -n1)"
	[ -n "$asset" ] && {
		echo "$asset"
		return 0
	}

	return 1
}

extract_zip_asset() {
	local asset_file="$1"
	local dest_dir="$2"

	if command -v unzip >/dev/null 2>&1; then
		unzip -qo "$asset_file" -d "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	if command -v busybox >/dev/null 2>&1; then
		busybox unzip -o "$asset_file" -d "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	if command -v bsdtar >/dev/null 2>&1; then
		bsdtar -xf "$asset_file" -C "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	if tar -tf "$asset_file" >/dev/null 2>&1; then
		tar -xf "$asset_file" -C "$dest_dir" >/dev/null 2>&1 && return 0
	fi

	return 1
}

validate_asset_file() {
	local asset_file="$1"

	[ -s "$asset_file" ] || return 1

	case "$asset_file" in
		*.zip)
			if command -v unzip >/dev/null 2>&1; then
				unzip -t "$asset_file" >/dev/null 2>&1 && return 0
			fi
			if command -v busybox >/dev/null 2>&1; then
				busybox unzip -t "$asset_file" >/dev/null 2>&1 && return 0
			fi
			if command -v bsdtar >/dev/null 2>&1; then
				bsdtar -tf "$asset_file" >/dev/null 2>&1 && return 0
			fi
			return 1
		;;
		*.tar.gz|*.tgz)
			tar -tzf "$asset_file" >/dev/null 2>&1
			return $?
		;;
		*.tar.xz)
			tar -tJf "$asset_file" >/dev/null 2>&1
			return $?
		;;
		*)
			return 0
		;;
	esac
}

extract_release_asset() {
	local asset_file="$1"
	local dest_dir="$2"
	local base

	rm -rf "$dest_dir"
	mkdir -p "$dest_dir"

	case "$asset_file" in
		*.tar.gz|*.tgz)
			tar -xzf "$asset_file" -C "$dest_dir" >/dev/null 2>&1 || return 1
		;;
		*.tar.xz)
			tar -xJf "$asset_file" -C "$dest_dir" >/dev/null 2>&1 || return 1
		;;
		*.zip)
			extract_zip_asset "$asset_file" "$dest_dir" || return 1
		;;
		*)
			base="$(basename "$asset_file")"
			cp -f "$asset_file" "${dest_dir}/${base}" >/dev/null 2>&1 || return 1
		;;
	esac
}

locate_extracted_bin() {
	local root="$1"
	local name="$2"
	local alt_dash alt_under found

	alt_dash="${name//_/-}"
	alt_under="${name//-/_}"

	found="$(
		find "$root" -type f \
			\( \
				-name "$name" -o \
				-name "${name}.bin" -o \
				-name "$alt_dash" -o \
				-name "${alt_dash}.bin" -o \
				-name "$alt_under" -o \
				-name "${alt_under}.bin" -o \
				-name "${name}-*" -o \
				-name "${name}_*" -o \
				-name "${alt_dash}-*" -o \
				-name "${alt_dash}_*" -o \
				-name "${alt_under}-*" -o \
				-name "${alt_under}_*" \
			\) 2>/dev/null | head -n1
	)"
	[ -n "$found" ] && {
		echo "$found"
		return 0
	}

	case "$name" in
		vnt2_cli)
			find "$root" -type f \( -name "vnt-cli" -o -name "vnt_cli" -o -name "vnt-cli-*" -o -name "vnt_cli_*" \) 2>/dev/null | head -n1
			return 0
		;;
		vnt2_ctrl)
			find "$root" -type f \( -name "vnt-ctrl" -o -name "vnt_ctrl" -o -name "vnt-ctrl-*" -o -name "vnt_ctrl_*" \) 2>/dev/null | head -n1
			return 0
		;;
		vnt2_web)
			find "$root" -type f \( -name "vnt-web" -o -name "vnt_web" -o -name "vnt-web-*" -o -name "vnt_web_*" \) 2>/dev/null | head -n1
			return 0
		;;
		vnts2)
			find "$root" -type f \( -name "vnts" -o -name "vnts-*" -o -name "vnts_*" \) 2>/dev/null | head -n1
			return 0
		;;
	esac

	return 1
}

normalize_server_binary_name() {
	local extracted_dir="$1"
	local server_bin normalized_bin

	server_bin="$(locate_extracted_bin "$extracted_dir" "vnts2")"
	[ -n "$server_bin" ] || server_bin="$(locate_extracted_bin "$extracted_dir" "vnts")"
	[ -n "$server_bin" ] || return 1

	normalized_bin="${extracted_dir}/vnts2"
	if [ "$server_bin" != "$normalized_bin" ]; then
		cp -f "$server_bin" "$normalized_bin" >/dev/null 2>&1 || return 1
	fi

	ensure_exec "$normalized_bin" || return 1
	echo "$normalized_bin"
	return 0
}

install_binary_to_usrbin() {
	local src="$1"
	local target_name="$2"
	local target_path

	[ -n "$src" ] || return 1
	[ -f "$src" ] || return 1
	[ -n "$target_name" ] || return 1
	target_path="${INSTALL_BIN_DIR}/${target_name}"

	mkdir -p "${INSTALL_BIN_DIR}" >/dev/null 2>&1 || {
		log_download "鍒涘缓瀹夎鐩綍澶辫触锛?{INSTALL_BIN_DIR}"
		return 1
	}
	cp -f "$src" "$target_path" >/dev/null 2>&1 || {
		log_download "澶嶅埗绋嬪簭鍒?${target_path} 澶辫触锛屾簮鏂囦欢锛?{src}"
		return 1
	}
	chmod 755 "$target_path" >/dev/null 2>&1 || {
		log_download "璁剧疆鎵ц鏉冮檺澶辫触锛?{target_path}"
		return 1
	}
	[ -f "$target_path" ] || {
		log_download "瀹夎鍚庢湭鎵惧埌鐩爣鏂囦欢锛?{target_path}"
		return 1
	}
	echo "$target_path"
	return 0
}

install_bundle_to_usrbin() {
	local extracted_dir="$1"
	local scope="$2"
	local cli_bin ctrl_bin web_bin server_bin

	case "$scope" in
		cli)
			cli_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_cli")"
			ctrl_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_ctrl")"
			ensure_exec "$cli_bin" || return 1
			ensure_exec "$ctrl_bin" || return 1
			install_binary_to_usrbin "$cli_bin" "vnt2_cli" >/dev/null || return 1
			install_binary_to_usrbin "$ctrl_bin" "vnt2_ctrl" >/dev/null || return 1
			web_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_web")"
			if ensure_exec "$web_bin"; then
				install_binary_to_usrbin "$web_bin" "vnt2_web" >/dev/null || return 1
			fi
		;;
		web)
			web_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_web")"
			ensure_exec "$web_bin" || return 1
			install_binary_to_usrbin "$web_bin" "vnt2_web" >/dev/null || return 1
		;;
		server)
			server_bin="$(normalize_server_binary_name "$extracted_dir")"
			ensure_exec "$server_bin" || return 1
			install_binary_to_usrbin "$server_bin" "vnts2" >/dev/null || return 1
		;;
		*)
			return 1
		;;
	esac

	return 0
}

cache_bundle_ready() {
	local extracted_dir="$1"
	local scope="$2"

	case "$scope" in
		cli)
			ensure_exec "$(locate_extracted_bin "$extracted_dir" "vnt2_cli")" && ensure_exec "$(locate_extracted_bin "$extracted_dir" "vnt2_ctrl")"
		;;
		web)
			ensure_exec "$(locate_extracted_bin "$extracted_dir" "vnt2_web")"
		;;
		server)
			ensure_exec "$(normalize_server_binary_name "$extracted_dir")"
		;;
		*)
			return 1
		;;
	esac
}

auto_download_bundle() {
	local cfg="$1"
	local scope="$2"
	local state_file="$3"

	local auto_download download_tag download_repo download_mirror effective_mirror api_url arch_name arch_patterns
	local cache_key cache_dir json_file release_tag asset_url asset_name asset_file extracted_dir
	local cli_bin ctrl_bin web_bin server_bin server_name

	config_get_bool auto_download "$cfg" "auto_download" "1"
	[ "$auto_download" = "1" ] || {
        write_download_state "$state_file" "disabled" "auto download disabled" "" "" "" ""
		return 1
	}

	case "$scope" in
		server)
			config_get download_tag "$cfg" "download_tag" "latest"
			config_get download_repo "$cfg" "download_repo" "vnt-dev/vnts"
			config_get download_mirror "$cfg" "download_mirror" "github"
		;;
		*)
			config_get download_tag "$cfg" "download_tag" "latest"
			config_get download_repo "$cfg" "download_repo" "vnt-dev/vnt"
			config_get download_mirror "$cfg" "download_mirror" "github"
		;;
	esac
	[ -n "$download_tag" ] || download_tag="latest"
	[ -n "$download_repo" ] || download_repo="vnt-dev/vnt"
	download_mirror="$(normalize_download_mirror "$download_mirror")"
	effective_mirror="$(select_download_mirror "$download_repo" "$download_mirror")"
	[ "$download_mirror" = "$effective_mirror" ] || \
		log_download "mirror ${download_mirror} not supported for repo ${download_repo}, fallback to ${effective_mirror}"
	download_tag="$(resolve_v2_release_tag "$download_repo" "$download_tag")"
	[ -n "$download_tag" ] || download_tag="latest"

	arch_name="$(detect_arch_name)"
	arch_patterns="$(detect_arch_patterns "$arch_name")"
	cache_key="$(sanitize_name "${effective_mirror}_${download_repo}_${download_tag}_${arch_name}_${scope}")"
	cache_dir="${DOWNLOAD_CACHE_BASE}/${cache_key}"
	json_file="${cache_dir}/release.json"
	extracted_dir="${cache_dir}/extracted"

	mkdir -p "$cache_dir"

	if cache_bundle_ready "$extracted_dir" "$scope"; then
		log_download "妫€娴嬪埌 ${scope} 宸叉湁缂撳瓨鍖咃紝鐩存帴澶嶇敤 ${extracted_dir}"
        write_download_state "$state_file" "cached" "reusing local cached bundle" "$(basename "$cache_dir")" "$download_tag" "$arch_name" "$extracted_dir"

		if install_bundle_to_usrbin "$extracted_dir" "$scope"; then
			case "$scope" in
				cli)
					uci -q set ${CONF}.${cfg}.vnt2_cli_bin="${INSTALL_BIN_DIR}/vnt2_cli"
					uci -q set ${CONF}.${cfg}.vnt2_ctrl_bin="${INSTALL_BIN_DIR}/vnt2_ctrl"
				;;
				web)
					uci -q set ${CONF}.${cfg}.vnt2_web_bin="${INSTALL_BIN_DIR}/vnt2_web"
				;;
				server)
					uci -q set ${CONF}.${cfg}.vnts2_bin="${INSTALL_BIN_DIR}/vnts2"
				;;
			esac
			uci commit ${CONF} >/dev/null 2>&1
			return 0
		fi
	fi

	api_url="$(get_release_api_url "$download_repo" "$download_tag" "$effective_mirror")"
	log_download "寮€濮嬫煡璇?${scope} 瀵瑰簲鍙戣鐗堬細repo=${download_repo} tag=${download_tag} arch=${arch_name}"

	write_download_state "$state_file" "querying" "querying releases (${effective_mirror})" "" "$download_tag" "$arch_name" ""
	log_download "querying ${scope} release repo=${download_repo} tag=${download_tag} mirror=${effective_mirror} arch=${arch_name}"
	api_url="$(fetch_release_metadata "$download_repo" "$download_tag" "$json_file" "$effective_mirror")"
	if [ -z "$api_url" ]; then
		log_download "release query failed repo=${download_repo} tag=${download_tag} mirror=${effective_mirror}"
		write_download_state "$state_file" "failed" "release query failed (${effective_mirror})" "" "$download_tag" "$arch_name" ""
		return 1
	fi

	log_download "release query ok: ${api_url}"
	release_tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$json_file" | head -n1)"
	release_tag="$(normalize_release_tag "$release_tag")"
	[ -n "$release_tag" ] || release_tag="$download_tag"
	asset_url="$(select_release_asset "$json_file" "$arch_patterns" "$scope")" || {
		log_download "鏈壘鍒板尮閰?${arch_name} 鐨?${scope} 鍙戣璧勬簮"
		write_download_state "$state_file" "failed" "鏈壘鍒板尮閰嶅綋鍓嶆灦鏋勭殑鍙戣璧勬簮" "" "$release_tag" "$arch_name" ""
		return 1
	}

	asset_name="$(basename "$asset_url")"
	asset_file="${cache_dir}/${asset_name}"
	write_download_state "$state_file" "downloading" "姝ｅ湪涓嬭浇鍙戣璧勬簮" "$asset_name" "$release_tag" "$arch_name" ""
	log_download "閫変腑璧勬簮 ${asset_name}"

	if [ -s "$asset_file" ]; then
		if validate_asset_file "$asset_file"; then
			log_download "澶嶇敤宸蹭笅杞借祫婧?${asset_file}"
		else
			log_download "妫€娴嬪埌缂撳瓨璧勬簮鏃犳晥锛屽垹闄ゅ悗閲嶆柊涓嬭浇锛?{asset_file}"
			rm -f "$asset_file"
		fi
	fi

	if [ ! -s "$asset_file" ]; then
		if ! download_file "$asset_url" "$asset_file" "asset"; then
			log_download "涓嬭浇鍙戣璧勬簮澶辫触锛歵ool=${DOWNLOAD_LAST_TOOL:-unknown} url=${asset_url}"
			write_download_state "$state_file" "failed" "涓嬭浇鍙戣璧勬簮澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
			return 1
		fi
		if ! validate_asset_file "$asset_file"; then
			log_download "涓嬭浇鍚庣殑鍙戣璧勬簮鏃犳晥鎴栧凡鎹熷潖锛?{asset_file}"
			rm -f "$asset_file"
            write_download_state "$state_file" "failed" "downloaded asset is invalid or corrupted" "$asset_name" "$release_tag" "$arch_name" ""
			return 1
		fi
	fi

    write_download_state "$state_file" "extracting" "extracting program files" "$asset_name" "$release_tag" "$arch_name" ""
	if ! extract_release_asset "$asset_file" "$extracted_dir"; then
		log_download "棣栨瑙ｅ帇澶辫触锛屽垹闄ょ紦瀛樺悗閲嶆柊涓嬭浇閲嶈瘯锛?{asset_file}"
		rm -f "$asset_file"
		if ! download_file "$asset_url" "$asset_file" "asset"; then
			log_download "閲嶈瘯涓嬭浇鍙戣璧勬簮澶辫触锛歵ool=${DOWNLOAD_LAST_TOOL:-unknown} url=${asset_url}"
			write_download_state "$state_file" "failed" "閲嶈瘯涓嬭浇鍙戣璧勬簮澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
			return 1
		fi
		if ! validate_asset_file "$asset_file"; then
			log_download "閲嶈瘯涓嬭浇鍚庣殑鍙戣璧勬簮浠嶇劧鏃犳晥锛?{asset_file}"
			rm -f "$asset_file"
			write_download_state "$state_file" "failed" "閲嶈瘯涓嬭浇鍚庣殑鍙戣璧勬簮鏃犳晥" "$asset_name" "$release_tag" "$arch_name" ""
			return 1
		fi
		if ! extract_release_asset "$asset_file" "$extracted_dir"; then
			log_download "瑙ｅ帇澶辫触锛?{asset_file}"
			write_download_state "$state_file" "failed" "瑙ｅ帇鍙戣璧勬簮澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
			return 1
		fi
	fi

	case "$scope" in
		cli)
			cli_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_cli")"
			ctrl_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_ctrl")"
			if ! ensure_exec "$cli_bin" || ! ensure_exec "$ctrl_bin"; then
				log_download "涓嬭浇鍖呬腑鏈壘鍒板畬鏁寸殑 vnt2_cli / vnt2_ctrl"
				write_download_state "$state_file" "failed" "涓嬭浇鍖呬腑鏈壘鍒板畬鏁寸殑 vnt2_cli / vnt2_ctrl" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			if ! install_bundle_to_usrbin "$extracted_dir" "cli"; then
				log_download "宸蹭笅杞藉鎴风绋嬪簭锛屼絾瀹夎鍒?/usr/bin 澶辫触"
				write_download_state "$state_file" "failed" "宸蹭笅杞藉鎴风绋嬪簭锛屼絾瀹夎鍒?/usr/bin 澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			uci -q set ${CONF}.${cfg}.vnt2_cli_bin="${INSTALL_BIN_DIR}/vnt2_cli"
			uci -q set ${CONF}.${cfg}.vnt2_ctrl_bin="${INSTALL_BIN_DIR}/vnt2_ctrl"
			uci commit ${CONF} >/dev/null 2>&1
			log_download "CLI 绋嬪簭宸插畨瑁呭畬鎴愶細cli=${INSTALL_BIN_DIR}/vnt2_cli ctrl=${INSTALL_BIN_DIR}/vnt2_ctrl"
			write_download_state "$state_file" "success" "宸茶嚜鍔ㄤ笅杞藉苟瀹夎 vnt2_cli / vnt2_ctrl 鍒?/usr/bin" "$asset_name" "$release_tag" "$arch_name" "${INSTALL_BIN_DIR}/vnt2_cli"
			return 0
		;;
		web)
			web_bin="$(locate_extracted_bin "$extracted_dir" "vnt2_web")"
			if ! ensure_exec "$web_bin"; then
				log_download "涓嬭浇鍖呬腑鏈壘鍒?vnt2_web"
				write_download_state "$state_file" "failed" "涓嬭浇鍖呬腑鏈壘鍒?vnt2_web" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			if ! install_bundle_to_usrbin "$extracted_dir" "web"; then
				log_download "宸蹭笅杞?Web 绋嬪簭锛屼絾瀹夎鍒?/usr/bin 澶辫触"
				write_download_state "$state_file" "failed" "宸蹭笅杞?Web 绋嬪簭锛屼絾瀹夎鍒?/usr/bin 澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			uci -q set ${CONF}.${cfg}.vnt2_web_bin="${INSTALL_BIN_DIR}/vnt2_web"
			uci commit ${CONF} >/dev/null 2>&1
			log_download "Web 绋嬪簭宸插畨瑁呭畬鎴愶細web=${INSTALL_BIN_DIR}/vnt2_web"
			write_download_state "$state_file" "success" "宸茶嚜鍔ㄤ笅杞藉苟瀹夎 vnt2_web 鍒?/usr/bin" "$asset_name" "$release_tag" "$arch_name" "${INSTALL_BIN_DIR}/vnt2_web"
			return 0
		;;
		server)
			server_name="vnts2"
			server_bin="$(normalize_server_binary_name "$extracted_dir")"
			if ! ensure_exec "$server_bin"; then
				log_download "涓嬭浇鍖呬腑鏈壘鍒板彲鐢ㄧ殑 vnts2 / vnts锛屾垨閲嶅懡鍚嶄负 vnts2 澶辫触"
				write_download_state "$state_file" "failed" "涓嬭浇鍖呬腑鏈壘鍒板彲鐢ㄧ殑 vnts2 / vnts锛屾垨閲嶅懡鍚嶄负 vnts2 澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			if ! install_bundle_to_usrbin "$extracted_dir" "server"; then
				log_download "宸蹭笅杞芥湇鍔＄绋嬪簭锛屼絾瀹夎鍒?/usr/bin 澶辫触"
				write_download_state "$state_file" "failed" "宸蹭笅杞芥湇鍔＄绋嬪簭锛屼絾瀹夎鍒?/usr/bin 澶辫触" "$asset_name" "$release_tag" "$arch_name" ""
				return 1
			fi
			uci -q set ${CONF}.${cfg}.vnts2_bin="${INSTALL_BIN_DIR}/vnts2"
			uci commit ${CONF} >/dev/null 2>&1
			log_download "鏈嶅姟绔▼搴忓凡瀹夎瀹屾垚锛歴erver=${INSTALL_BIN_DIR}/vnts2"
			write_download_state "$state_file" "success" "宸茶嚜鍔ㄤ笅杞藉苟瀹夎 vnts2 鍒?/usr/bin" "$asset_name" "$release_tag" "$arch_name" "${INSTALL_BIN_DIR}/vnts2"
			return 0
		;;
	esac

	write_download_state "$state_file" "failed" "鏈煡涓嬭浇鑼冨洿" "$asset_name" "$release_tag" "$arch_name" ""
	return 1
}

prepare_binary() {
	local cfg="$1"
	local option="$2"
	local default_path="$3"
	local upload_name="$4"
	local state_file="$5"
	local scope="$6"

	local bin uploaded target_name installed_bin
	config_get bin "$cfg" "$option" "$default_path"

	if ensure_exec "$bin"; then
		echo "$bin"
		return 0
	fi

	if auto_download_bundle "$cfg" "$scope" "$state_file"; then
		bin="$(uci -q get ${CONF}.${cfg}.${option})"
		if ensure_exec "$bin"; then
			echo "$bin"
			return 0
		fi
	fi

	uploaded="$(find_uploaded_bin "$upload_name")"
	if [ -n "$uploaded" ]; then
		log_download "${scope} 鑷姩涓嬭浇澶辫触锛屽洖閫€鍒版湰鍦颁笂浼犵▼搴?${uploaded}"
		target_name="${option%_bin}"
		installed_bin="$(install_binary_to_usrbin "$uploaded" "$target_name" 2>/dev/null)"
		if ensure_exec "$installed_bin"; then
			bin="$installed_bin"
            write_download_state "$state_file" "fallback" "auto download failed, using uploaded binary installed to /usr/bin" "$(basename "$uploaded")" "" "$(detect_arch_name)" "$installed_bin"
		else
			bin="$uploaded"
            write_download_state "$state_file" "fallback" "auto download failed, using uploaded binary without install promotion" "$(basename "$uploaded")" "" "$(detect_arch_name)" "$uploaded"
		fi
		uci -q set ${CONF}.${cfg}.${option}="$bin"
		uci commit ${CONF} >/dev/null 2>&1
	fi

	ensure_exec "$bin" || return 1
	echo "$bin"
	return 0
}

toml_get_raw() {
	local file="$1"
	local key="$2"
	[ -f "$file" ] || return 1
	sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$file" | head -n1
}

toml_get_string() {
	local file="$1"
	local key="$2"
	local raw val

	raw="$(toml_get_raw "$file" "$key" 2>/dev/null)"
	raw="$(trim_value "$raw")"
	case "$raw" in
		\"*\")
			val="${raw#\"}"
			val="${val%\"}"
			printf '%s\n' "$val" | sed 's/\\"/"/g; s/\\\\/\\/g'
		;;
		*)
			printf '%s\n' "$raw"
		;;
	esac
}

toml_get_bool() {
	local file="$1"
	local key="$2"
	local raw
	raw="$(trim_value "$(toml_get_raw "$file" "$key" 2>/dev/null)")"
	[ "$raw" = "true" ] && echo "1" || echo "0"
}

toml_validate_client_config() {
	local file="$1"
	local network_code server_line

	[ -f "$file" ] || {
		log_cli "瀹㈡埛绔厤缃枃浠朵笉瀛樺湪锛?file"
		return 1
	}

	network_code="$(trim_value "$(toml_get_string "$file" "network_code")")"
	server_line="$(trim_value "$(toml_get_raw "$file" "server")")"

	[ -n "$network_code" ] || {
		log_cli "瀹㈡埛绔厤缃牎楠屽け璐ワ細network_code 涓嶈兘涓虹┖"
		return 1
	}

	case "$server_line" in
		\[*\])
			:
		;;
		*)
			log_cli "瀹㈡埛绔厤缃牎楠屽け璐ワ細server 鍒楄〃涓嶈兘涓虹┖"
			return 1
		;;
	esac

	return 0
}

toml_validate_server_config() {
	local file="$1"
	[ -f "$file" ] || {
		log_server "鏈嶅姟绔厤缃枃浠朵笉瀛樺湪锛?file"
		return 1
	}
	return 0
}

configure_network() {
	local tun_name="$1"
	local forward_list="$2"
	local no_nat="$3"
	local lan_zone wan_zone enable_ip_forward="${no_nat:-0}"

	[ -n "$tun_name" ] || tun_name="vnt-tun"
	lan_zone="$(find_firewall_zone_name "lan" 2>/dev/null || true)"
	wan_zone="$(find_firewall_zone_name "wan" 2>/dev/null || true)"

	uci -q delete network.VNT2
	uci set network.VNT2='interface'
	uci set network.VNT2.proto='none'
	uci set network.VNT2.device="$tun_name"
	uci set network.VNT2.ifname="$tun_name"

	uci -q delete firewall.vnt2zone
	uci set firewall.vnt2zone='zone'
	uci set firewall.vnt2zone.name='VNT2'
	uci set firewall.vnt2zone.input='ACCEPT'
	uci set firewall.vnt2zone.output='ACCEPT'
	uci set firewall.vnt2zone.forward='ACCEPT'
	uci set firewall.vnt2zone.masq='1'
	uci set firewall.vnt2zone.mtu_fix='1'
	uci set firewall.vnt2zone.network='VNT2'

	case " $forward_list " in
		*" vnt2fwlan "*)
			if [ -n "$lan_zone" ]; then
				uci set firewall.vnt2fwlan='forwarding'
				uci set firewall.vnt2fwlan.src='VNT2'
				uci set firewall.vnt2fwlan.dest="${lan_zone}"
			else
				uci -q delete firewall.vnt2fwlan
			fi
		;;
		*)
			uci -q delete firewall.vnt2fwlan
		;;
	esac

	case " $forward_list " in
		*" vnt2fwwan "*)
			if [ -n "$wan_zone" ]; then
				uci set firewall.vnt2fwwan='forwarding'
				uci set firewall.vnt2fwwan.src='VNT2'
				uci set firewall.vnt2fwwan.dest="${wan_zone}"
			else
				uci -q delete firewall.vnt2fwwan
			fi
		;;
		*)
			uci -q delete firewall.vnt2fwwan
		;;
	esac

	case " $forward_list " in
		*" lanfwvnt2 "*)
			if [ -n "$lan_zone" ]; then
				uci set firewall.lanfwvnt2='forwarding'
				uci set firewall.lanfwvnt2.src="${lan_zone}"
				uci set firewall.lanfwvnt2.dest='VNT2'
			else
				uci -q delete firewall.lanfwvnt2
			fi
		;;
		*)
			uci -q delete firewall.lanfwvnt2
		;;
	esac

	case " $forward_list " in
		*" wanfwvnt2 "*)
			if [ -n "$wan_zone" ]; then
				uci set firewall.wanfwvnt2='forwarding'
				uci set firewall.wanfwvnt2.src="${wan_zone}"
				uci set firewall.wanfwvnt2.dest='VNT2'
			else
				uci -q delete firewall.wanfwvnt2
			fi
		;;
		*)
			uci -q delete firewall.wanfwvnt2
		;;
	esac

	[ -n "$(uci changes network)" ] && uci commit network && /etc/init.d/network reload >/dev/null 2>&1
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
	[ "$enable_ip_forward" = "0" ] || sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
}

cleanup_network() {
	uci -q delete network.VNT2
	uci -q delete firewall.vnt2zone
	uci -q delete firewall.vnt2fwlan
	uci -q delete firewall.vnt2fwwan
	uci -q delete firewall.lanfwvnt2
	uci -q delete firewall.wanfwvnt2
	[ -n "$(uci changes network)" ] && uci commit network && /etc/init.d/network reload >/dev/null 2>&1
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
}

ensure_firewall_rule() {
	local rule="$1"
	local name="$2"
	local proto="$3"
	local port="$4"
	local src_zone="${5:-wan}"

	uci set firewall.${rule}='rule'
	uci set firewall.${rule}.name="${name}"
	uci set firewall.${rule}.src="${src_zone}"
	uci set firewall.${rule}.target='ACCEPT'
	uci set firewall.${rule}.proto="${proto}"
	uci set firewall.${rule}.dest_port="${port}"
	uci set firewall.${rule}.enabled='1'
}

configure_web_firewall() {
	local host="$1"
	local port="$2"
	local wan="$3"
	local wan_zone

	wan_zone="$(find_firewall_zone_name "wan" 2>/dev/null || true)"

	uci -q delete firewall.vnt2web
	if [ "$wan" = "1" ] && [ -n "$port" ] && [ -n "$wan_zone" ] && host_allows_external_access "$host"; then
		ensure_firewall_rule "vnt2web" "vnt2_web" "tcp" "$port" "$wan_zone"
	fi
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
}

cleanup_web_firewall() {
	uci -q delete firewall.vnt2web
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
}

configure_server_firewall() {
	local tcp_bind="$1"
	local quic_bind="$2"
	local ws_bind="$3"
	local web_bind="$4"
	local open_tcp="$5"
	local open_quic="$6"
	local open_ws="$7"
	local open_web="$8"
	local wan_zone

	local tcp_port quic_port ws_port web_port
	tcp_port="${tcp_bind##*:}"
	quic_port="${quic_bind##*:}"
	ws_port="${ws_bind##*:}"
	web_port="${web_bind##*:}"
	wan_zone="$(find_firewall_zone_name "wan" 2>/dev/null || true)"

	uci -q delete firewall.vnts2_tcp
	uci -q delete firewall.vnts2_quic
	uci -q delete firewall.vnts2_ws
	uci -q delete firewall.vnts2_web

	[ "$open_tcp" = "1" ] && [ -n "$tcp_port" ] && [ -n "$wan_zone" ] && bind_allows_external_access "$tcp_bind" && ensure_firewall_rule "vnts2_tcp" "vnts2_tcp" "tcp" "$tcp_port" "$wan_zone"
	[ "$open_quic" = "1" ] && [ -n "$quic_port" ] && [ -n "$wan_zone" ] && bind_allows_external_access "$quic_bind" && ensure_firewall_rule "vnts2_quic" "vnts2_quic" "udp" "$quic_port" "$wan_zone"
	[ "$open_ws" = "1" ] && [ -n "$ws_port" ] && [ -n "$wan_zone" ] && bind_allows_external_access "$ws_bind" && ensure_firewall_rule "vnts2_ws" "vnts2_ws" "tcp" "$ws_port" "$wan_zone"
	[ "$open_web" = "1" ] && [ -n "$web_port" ] && [ -n "$wan_zone" ] && bind_allows_external_access "$web_bind" && ensure_firewall_rule "vnts2_web" "vnts2_web" "tcp" "$web_port" "$wan_zone"

	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
}

cleanup_server_firewall() {
	uci -q delete firewall.vnts2_tcp
	uci -q delete firewall.vnts2_quic
	uci -q delete firewall.vnts2_ws
	uci -q delete firewall.vnts2_web
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload >/dev/null 2>&1
}

prepare_cli_runtime() {
	local cfg="$1"

	CLI_CONF_FILE="$(resolve_client_conf_file "$cfg")"
	ensure_conf_path_ready "${CLI_CONF_FILE}"

	if ! toml_validate_client_config "${CLI_CONF_FILE}"; then
		return 1
	fi

	prepare_client_network_runtime "$cfg" "${CLI_CONF_FILE}"
}

prepare_client_network_runtime() {
	local cfg="$1"
	local conf_file="$2"
	local bind_dev="" forward_list="" tun_name no_tun no_nat

	VNT2_FORWARD_LIST=""
	if [ -n "$cfg" ]; then
		config_get bind_dev "$cfg" "bind_dev"
		config_list_foreach "$cfg" vnt2_forward append_forward_item
		forward_list="${VNT2_FORWARD_LIST}"
	fi

	tun_name="$(trim_value "$(toml_get_string "${conf_file}" "tun_name")")"
	[ -n "$tun_name" ] || tun_name="vnt-tun"
	no_tun="$(toml_get_bool "${conf_file}" "no_tun")"
	no_nat="$(toml_get_bool "${conf_file}" "no_proxy")"
	[ -n "$no_nat" ] || no_nat="0"

	VNT2_BIND_DEV="${bind_dev}"
	VNT2_TUN_NAME="${tun_name}"
	VNT2_NO_TUN="${no_tun}"
	VNT2_NO_NAT="${no_nat}"
	VNT2_FORWARD_LIST="${forward_list}"
	return 0
}

append_forward_item() {
	local value="$1"
	value="$(trim_value "$value")"
	[ -n "$value" ] || return 0
	if [ -n "${VNT2_FORWARD_LIST}" ]; then
		VNT2_FORWARD_LIST="${VNT2_FORWARD_LIST} ${value}"
	else
		VNT2_FORWARD_LIST="${value}"
	fi
}

append_server_item() {
	local value="$1"
	value="$(trim_value "$value")"
	[ -n "$value" ] || return 0
	if [ -n "${VNT2_SERVER_LIST}" ]; then
		VNT2_SERVER_LIST="${VNT2_SERVER_LIST} ${value}"
	else
		VNT2_SERVER_LIST="${value}"
	fi
}

prepare_server_runtime() {
	local cfg="${1:-vnts2}"

	SERVER_CONF_FILE="$(resolve_server_conf_file "$cfg")"
	ensure_conf_path_ready "${SERVER_CONF_FILE}"

	if ! toml_validate_server_config "${SERVER_CONF_FILE}"; then
		return 1
	fi

	VNTS2_TCP_BIND="$(trim_value "$(toml_get_string "${SERVER_CONF_FILE}" "tcp_bind")")"
	VNTS2_QUIC_BIND="$(trim_value "$(toml_get_string "${SERVER_CONF_FILE}" "quic_bind")")"
	VNTS2_WS_BIND="$(trim_value "$(toml_get_string "${SERVER_CONF_FILE}" "ws_bind")")"
	VNTS2_WEB_BIND="$(trim_value "$(toml_get_string "${SERVER_CONF_FILE}" "web_bind")")"

	[ -n "${VNTS2_TCP_BIND}" ] || VNTS2_TCP_BIND="0.0.0.0:29872"
	[ -n "${VNTS2_QUIC_BIND}" ] || VNTS2_QUIC_BIND="0.0.0.0:29872"
	[ -n "${VNTS2_WS_BIND}" ] || VNTS2_WS_BIND="0.0.0.0:29872"
	[ -n "${VNTS2_WEB_BIND}" ] || VNTS2_WEB_BIND="0.0.0.0:29871"

	return 0
}

start_cli_instance() {
	local cfg="$1"
	local enabled cli_bin ctrl_bin

	config_get_bool enabled "$cfg" "enabled" "0"
	if [ "$enabled" != "1" ]; then
		log_cli "鏈惎鐢紝璺宠繃鍚姩"
		return 0
	fi

	log_cli 'start requested'
	config_get cli_bin "$cfg" "vnt2_cli_bin" "/usr/bin/vnt2_cli"
	config_get ctrl_bin "$cfg" "vnt2_ctrl_bin" "/usr/bin/vnt2_ctrl"

	if ! ensure_exec "$cli_bin" || ! ensure_exec "$ctrl_bin"; then
		log_cli 'existing CLI/CTRL incomplete, trying auto-download or uploaded fallback'
		cli_bin="$(prepare_binary "$cfg" "vnt2_cli_bin" "/usr/bin/vnt2_cli" "vnt2_cli" "$DOWNLOAD_CLI_STATE" "cli")" || {
			log_cli 'start failed: missing vnt2_cli or vnt2_ctrl'
			return 1
		}
		ctrl_bin="$(uci -q get ${CONF}.${cfg}.vnt2_ctrl_bin)"
		if ! ensure_exec "$ctrl_bin"; then
			log_cli 'start failed: vnt2_ctrl missing after recovery'
			return 1
		fi
	else
		log_cli "妫€娴嬪埌鐜版湁 CLI/CTRL 绋嬪簭瀹屾暣锛歝li=${cli_bin} ctrl=${ctrl_bin}"
	fi

	VNT2_FORWARD_LIST=""
	if ! prepare_cli_runtime "$cfg"; then
		log_cli "鍚姩澶辫触锛氬鎴风 TOML 閰嶇疆鏍￠獙澶辫触"
		return 1
	fi

	if [ "${VNT2_NO_TUN}" != "1" ]; then
		configure_network "${VNT2_TUN_NAME}" "${VNT2_FORWARD_LIST}" "${VNT2_NO_NAT}"
	else
		cleanup_network
	fi

	log_cli "浣跨敤 ${cli_bin} 鍚姩锛岄厤缃枃浠?${CLI_CONF_FILE}"
	procd_open_instance "vnt2_cli"
	[ -n "${VNT2_BIND_DEV}" ] && procd_set_param env VNT_BIND_DEV="${VNT2_BIND_DEV}"
	procd_set_param command /bin/sh -c "exec \"${cli_bin}\" --conf \"${CLI_CONF_FILE}\" >>\"${CLI_LOG}\" 2>&1"
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param respawn
	procd_set_param file "${CLI_CONF_FILE}"
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param term_timeout 10
	procd_close_instance
	date +%s >"${CLI_TIME}"
	log_cli 'start command submitted'
}

start_web_instance() {
	local cfg="$1"
	local enabled web_bin web_host web_port web_wan log_level cli_cfg

	config_get_bool enabled "$cfg" "enabled" "0"
	if [ "$enabled" != "1" ]; then
		log_web 'not enabled, skip start'
		return 0
	fi

	log_web 'start requested'
	web_bin="$(prepare_binary "$cfg" "vnt2_web_bin" "/usr/bin/vnt2_web" "vnt2_web" "$DOWNLOAD_WEB_STATE" "web")" || {
		log_web 'start failed: missing executable vnt2_web'
		return 1
	}

	config_get web_host "$cfg" "web_host" "0.0.0.0"
	config_get web_port "$cfg" "web_port" "19099"
	config_get_bool web_wan "$cfg" "web_wan" "1"
	config_get log_level "$cfg" "log_level" "info"

	WEB_CONF_FILE="$(resolve_web_conf_file "$cfg")"
	ensure_conf_path_ready "${WEB_CONF_FILE}"
	if ! toml_validate_client_config "${WEB_CONF_FILE}"; then
		log_web 'start failed: client TOML validation failed'
		return 1
	fi

	cli_cfg="$(get_first_section_id "vnt2_cli")"
	if ! prepare_client_network_runtime "$cli_cfg" "${WEB_CONF_FILE}"; then
		log_web 'start failed: client network runtime preparation failed'
		return 1
	fi

	if [ "${VNT2_NO_TUN}" != "1" ]; then
		configure_network "${VNT2_TUN_NAME}" "${VNT2_FORWARD_LIST}" "${VNT2_NO_NAT}"
	else
		cleanup_network
	fi

	configure_web_firewall "$web_host" "$web_port" "$web_wan"
    log_web "using ${web_bin} on ${web_host}:${web_port}, conf=${WEB_CONF_FILE}"
	procd_open_instance "vnt2_web"
	procd_set_param env RUST_LOG="$log_level"
	procd_set_param command /bin/sh -c "exec \"${web_bin}\" --addr \"${web_host}:${web_port}\" --conf \"${WEB_CONF_FILE}\" >>\"${WEB_LOG}\" 2>&1"
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param respawn
	procd_set_param file "${WEB_CONF_FILE}"
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param term_timeout 10
	procd_close_instance
	date +%s >"${WEB_TIME}"
	log_web 'start command submitted'
}

start_server_instance() {
	local cfg="$1"
	local enabled server_bin
	local open_tcp open_quic open_ws open_web

	config_get_bool enabled "$cfg" "enabled" "0"
	if [ "$enabled" != "1" ]; then
		log_server "鏈惎鐢紝璺宠繃鍚姩"
		return 0
	fi

	log_server 'start requested'
	server_bin="$(prepare_binary "$cfg" "vnts2_bin" "/usr/bin/vnts2" "vnts2" "$DOWNLOAD_SERVER_STATE" "server")" || {
		log_server "鍚姩澶辫触锛氭湭鎵惧埌鍙墽琛屾枃浠讹紝璇蜂笂浼犳垨瀹夎 vnts2"
		return 1
	}

	if ! prepare_server_runtime "$cfg"; then
		log_server "鍚姩澶辫触锛氭湇鍔＄ TOML 閰嶇疆鏍￠獙澶辫触"
		return 1
	fi

	config_get_bool open_tcp "$cfg" "open_wan_tcp" "0"
	config_get_bool open_quic "$cfg" "open_wan_quic" "0"
	config_get_bool open_ws "$cfg" "open_wan_ws" "0"
	config_get_bool open_web "$cfg" "open_wan_web" "0"

	configure_server_firewall "${VNTS2_TCP_BIND}" "${VNTS2_QUIC_BIND}" "${VNTS2_WS_BIND}" "${VNTS2_WEB_BIND}" "$open_tcp" "$open_quic" "$open_ws" "$open_web"

	log_server "浣跨敤 ${server_bin} 鍚姩锛岄厤缃枃浠?${SERVER_CONF_FILE}"
	procd_open_instance "vnts2"
	procd_set_param command /bin/sh -c "exec \"${server_bin}\" --conf \"${SERVER_CONF_FILE}\" >>\"${SERVER_LOG}\" 2>&1"
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param respawn
	procd_set_param file "${SERVER_CONF_FILE}"
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param term_timeout 10
	procd_close_instance
	date +%s >"${SERVER_TIME}"
	log_server 'start command submitted'
}

start_service() {
	local cli_cfg web_cfg server_cfg

	ensure_log_files
	log_cli 'service start flow begin'
	log_web 'service start flow begin'
	log_server 'service start flow begin'
	log_download 'service start flow begin'

	if export_toml_from_uci; then
		log_cli "宸蹭粠 UCI 閲嶆柊瀵煎嚭 TOML 閰嶇疆"
		log_web "宸蹭粠 UCI 閲嶆柊瀵煎嚭 TOML 閰嶇疆"
		log_server "宸蹭粠 UCI 閲嶆柊瀵煎嚭 TOML 閰嶇疆"
	else
		log_cli 'UCI to TOML export failed, continue with existing config'
		log_web 'UCI to TOML export failed, continue with existing config'
		log_server 'UCI to TOML export failed, continue with existing config'
	fi

	config_load "${CONF}"
	cli_cfg="$(get_first_section_id "vnt2_cli")"
	web_cfg="$(get_first_section_id "vnt2_web")"
	server_cfg="$(get_first_section_id "vnts2")"

	[ -n "$cli_cfg" ] && migrate_legacy_client_server "$cli_cfg"
	config_load "${CONF}"
	cli_cfg="$(get_first_section_id "vnt2_cli")"
	web_cfg="$(get_first_section_id "vnt2_web")"
	server_cfg="$(get_first_section_id "vnts2")"

    [ -n "$cli_cfg" ] && start_cli_instance "$cli_cfg" || log_cli 'vnt2_cli config section not found'
    [ -n "$web_cfg" ] && start_web_instance "$web_cfg" || log_web 'vnt2_web config section not found'
    [ -n "$server_cfg" ] && start_server_instance "$server_cfg" || log_server 'vnts2 config section not found'

	log_download "鏈嶅姟鍚姩娴佺▼缁撴潫"
}

stop_service() {
	ensure_log_files
	log_cli 'service stop flow begin'
	log_web 'service stop flow begin'
	log_server 'service stop flow begin'
	log_download 'service stop flow begin'

	rm -f "${CLI_TIME}" "${WEB_TIME}" "${SERVER_TIME}"
	cleanup_network
	cleanup_web_firewall
	cleanup_server_firewall

	log_cli 'service stopped'
	log_web 'service stopped'
	log_server 'service stopped'
	log_download "鏈嶅姟鍋滄娴佺▼缁撴潫"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "${CONF}"
}
